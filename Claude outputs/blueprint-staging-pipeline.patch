diff --git a/.github/dependabot.yml b/.github/dependabot.yml
new file mode 100644
index 0000000..cf3381c
--- /dev/null
+++ b/.github/dependabot.yml
@@ -0,0 +1,27 @@
+version: 2
+updates:
+  - package-ecosystem: npm
+    directory: "/"
+    schedule:
+      interval: weekly
+      day: monday
+      time: "09:00"
+      timezone: America/Sao_Paulo
+    target-branch: develop
+    open-pull-requests-limit: 5
+    commit-message:
+      prefix: chore
+    groups:
+      # One PR for all the low-risk bumps, so review is a single pass.
+      minor-and-patch:
+        update-types: [minor, patch]
+    ignore:
+      # Majors land as their own PR, reviewed deliberately — never grouped.
+      - dependency-name: "*"
+        update-types: [version-update:semver-major]
+
+  - package-ecosystem: github-actions
+    directory: "/"
+    schedule:
+      interval: monthly
+    target-branch: develop
diff --git a/.github/workflows/ci-deploy.yml b/.github/workflows/ci-deploy.yml
new file mode 100644
index 0000000..88d8176
--- /dev/null
+++ b/.github/workflows/ci-deploy.yml
@@ -0,0 +1,72 @@
+name: CI and deploy
+
+on:
+  push:
+    branches: [develop]
+  pull_request:
+    branches: [develop]
+
+concurrency:
+  group: ci-deploy-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  verify:
+    name: Typecheck, audit and build
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+
+      # npm ci installs exactly what package-lock.json pins.
+      # Never swap this for `npm install` or `npm update`: the deploy must be
+      # reproducible from the commit alone.
+      - name: Install
+        run: npm ci
+
+      - name: Typecheck
+        run: npm run typecheck
+
+      # Fails the build on a known critical advisory. This is what would have
+      # caught Next 16.4.0 before it reached staging.
+      - name: Security audit
+        run: npm audit --audit-level=critical
+
+      - name: Build static export
+        run: npm run build
+
+      # Enable once S1.6 lands Cypress.
+      # - name: End-to-end tests
+      #   uses: cypress-io/github-action@v6
+      #   with:
+      #     start: npx serve out -l 3000
+      #     wait-on: 'http://localhost:3000'
+
+      - name: Upload build output
+        uses: actions/upload-artifact@v4
+        with:
+          name: out
+          path: out
+          retention-days: 7
+
+  deploy:
+    name: Deploy to Cloudflare
+    needs: verify
+    if: github.event_name == 'push' && github.ref == 'refs/heads/develop'
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/download-artifact@v4
+        with:
+          name: out
+          path: out
+
+      - name: Publish
+        uses: cloudflare/wrangler-action@v3
+        with:
+          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
+          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
+          command: pages deploy out --project-name=platform-blueprint --branch=develop
